# Template for docker-compose.override.yml
#
# Copy this file to docker-compose.override.yml and adjust it:
#
#     cp docker-compose.override.yml.template docker-compose.override.yml
#
# For a regular (public/production) registry instance, you only need to adjust
# Section 1. Sections 2-4 are optional and commented out; leave them as they
# are unless you know you need them. To uncomment a line, replace its leading
# '#' with a space, so the indentation stays intact.
#
# Note on connectivity: the registry itself only speaks plain HTTP on port
# 9292 (mapped to the host in docker-compose.yml; port 9293 is the metrics
# endpoint, reachable from localhost only). To make the instance publicly
# reachable via HTTPS, run a reverse proxy (e.g. nginx) on the host that
# terminates TLS and forwards to localhost:9292. To check that the service
# itself is running, on the server run: curl -i http://localhost:9292/

services:
  registry:
    environment:

      # ----------------------------------------------------------------------
      # Section 1: STANDARD SETTINGS - adjust these for your instance
      # ----------------------------------------------------------------------

      # Public URL under which this registry instance will be reachable:
      - REGISTRY_SERVICE_URL=https://url.of.this.registry.com/

      # Which nanopublications this instance covers:
      - REGISTRY_COVERAGE_TYPES=all
      - REGISTRY_COVERAGE_AGENTS=viaSetting

      # Existing registry instances to connect to (whitespace-separated):
      - REGISTRY_PEER_URLS=https://registry.petapico.org/ https://registry.knowledgepixels.com/

      # ----------------------------------------------------------------------
      # Section 2: OPTIONAL FLAGS - the defaults are fine for most instances
      # ----------------------------------------------------------------------

#     - REGISTRY_PERFORM_FULL_LOAD=false
#     - REGISTRY_PRIORITIZE_ALL_PUBKEYS=true  # Load all discovered pubkeys at high priority, not just trust-approved ones
#                                             # (all pubkeys are loaded eventually; this flag removes the throttling)
#     - REGISTRY_ENABLE_OPTIONAL_LOAD=false  # Disable loading nanopubs for non-approved pubkeys (discovered via peers)
#     - REGISTRY_ENABLE_TRUST_CALCULATION=false  # Skip trust path calculation (use with explicit REGISTRY_COVERAGE_AGENTS)
#     - REGISTRY_UPDATE_INTERVAL=600  # Seconds between trust state recalculations, measured from the end of the previous one
#     - REGISTRY_UPDATE_MIN_INTERVAL=120  # Seconds a recalculation triggered by incoming trust data can be brought forward to;
#                                         # a cycle fetches every account's lists from the peers, so this bounds that load
#     - REGISTRY_UPDATE_TRIGGER_JITTER=30  # Seconds of random delay on a triggered recalculation, so that registries seeing
#                                          # the same publication do not all recompute at once
#     - REGISTRY_TEST_INSTANCE=true  # Set as test instance; only has an effect on DB initialization
#     - REGISTRY_LOCAL_INSTANCE=true  # Local/private instance: accept nanopubs of type npx:ProtectedNanopub
#                                     # (public instances reject them; do NOT enable on a public instance)
#     - REGISTRY_SETTING_FILE=/data/registry.trig

      # ----------------------------------------------------------------------
      # Section 3: SHARED MONGODB - ONLY for setups that use an external
      # MongoDB instead of the bundled 'mongodb' container.
      #
      # WARNING: Do NOT uncomment these in a normal setup! The registry would
      # then try to reach MongoDB at the wrong address and fail to connect.
      # By default it connects to the bundled container (host 'mongodb'),
      # which needs no configuration here.
      # ----------------------------------------------------------------------

#     - REGISTRY_DB_HOST=172.17.0.1  # Address of the shared MongoDB (here: the Docker bridge IP of the host)

      # ----------------------------------------------------------------------
      # Section 4: DEVELOPMENT / TEST ONLY - do not enable on a public
      # production instance.
      # ----------------------------------------------------------------------

    # Serve on a different host port (e.g. 9290 for a test instance running
    # next to a main instance); '!override' replaces the port list from
    # docker-compose.yml instead of adding to it:
#   ports: !override
#     - 9290:9292

    # Enable remote JVM debugging on port 5005:
#   ports:
#     - 5005:5005
#   entrypoint: 'java -jar -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005 nanopub-registry.jar'

  # Disable the bundled MongoDB container; ONLY when using a shared MongoDB
  # (see Section 3 above):
# mongodb:
#   deploy:
#     replicas: 0

  # Mongo Express, a web UI for inspecting the MongoDB contents, served at
  # localhost:8081 (development only):
# mongo-express:
#   image: mongo-express
#   environment:
#     ME_CONFIG_MONGODB_URL: mongodb://mongodb:27017/?directConnection=true&tls=false
#     ME_CONFIG_BASICAUTH_USERNAME: admin
#     ME_CONFIG_BASICAUTH_PASSWORD: SET PASSWORD HERE!!!
#   ports:
#     - 8081:8081
#   logging:
#     options:
#       max-size: "10m"
#       max-file: "3"
